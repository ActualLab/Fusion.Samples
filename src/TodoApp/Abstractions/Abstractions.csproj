<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Samples.TodoApp.Abstractions</RootNamespace>
    <AssemblyName>Samples.TodoApp.Abstractions</AssemblyName>
  </PropertyGroup>

  <!-- Fusion packages -->
  <ItemGroup>
    <PackageReference Include="ActualLab.Fusion" />
    <PackageReference Include="ActualLab.Fusion.Ext.Contracts" />
  </ItemGroup>

  <!-- Other packages -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" />
  </ItemGroup>

  <!-- TypeScript contracts for TypeScriptUI, regenerated on build (only checked on CI) -->
  <PropertyGroup>
    <ActualLabRpcTypeScriptOutput>..\TypeScriptUI\src\contracts.generated.ts</ActualLabRpcTypeScriptOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ActualLab.Rpc.TypeScript.Generator" PrivateAssets="all" />
  </ItemGroup>

  <!-- Source generators -->
  <ItemGroup>
    <PackageReference Include="ActualLab.Generators" PrivateAssets="all" />
  </ItemGroup>

</Project>
